#!/usr/bin/env python3
"""Offline stand-in for `gh api`: serves FAKE_GH_API responses and logs each call."""

import io
import json
import os
import sys
import zipfile

arguments = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps(arguments) + "\n")
if arguments[:1] != ["api"]:
    sys.exit(1)
endpoint = arguments[-1]
with open(os.environ["FAKE_GH_API"], encoding="utf-8") as stream:
    responses = json.load(stream)
response = responses.get(endpoint.split("?", 1)[0])
if response is None:
    print(f"no fixture for {endpoint}", file=sys.stderr)
    sys.exit(1)
if "zip" in response:
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w") as archive:
        for name, content in response["zip"].items():
            archive.writestr(name, json.dumps(content))
    sys.stdout.buffer.write(buffer.getvalue())
elif "--jq" in arguments:
    key = arguments[arguments.index("--jq") + 1].removeprefix(".").removesuffix("[]")
    items = response["json"][key] if key else response["json"]
    print("\n".join(json.dumps(item) for item in items))
else:
    print(json.dumps(response["json"]))
