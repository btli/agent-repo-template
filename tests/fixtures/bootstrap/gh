#!/usr/bin/env python3
"""Offline stand-in for `gh api` that logs every call and never reaches the real CLI."""

import json
import os
import signal
import sys

arguments = sys.argv[1:]
method = "GET"
body = None
if "-X" in arguments:
    method = arguments[arguments.index("-X") + 1]
if "--input" in arguments:
    body = json.loads(sys.stdin.read() or "null")
endpoint = arguments[-1] if arguments else ""
with open(os.environ["FAKE_GH_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps({"argv": arguments, "method": method, "endpoint": endpoint, "body": body}))
    log.write("\n")
if arguments[:1] != ["api"]:
    print("fake gh only serves api calls", file=sys.stderr)
    sys.exit(1)
with open(os.environ["FAKE_GH_STATE"], encoding="utf-8") as stream:
    responses = json.load(stream)
bare = endpoint.split("?", 1)[0]
key = f"{method} {endpoint}"
response = responses.get(key, responses.get(f"{method} {bare}"))
if response is None and method != "GET":
    response = {"json": responses.get("default-write", {})}
if response is None:
    print(f"no fixture for {key}", file=sys.stderr)
    sys.exit(1)
if response.get("kill"):
    # The write lands, but the bootstrap process dies before it reads the response.
    os.kill(os.getppid(), signal.SIGKILL)
    sys.exit(1)
if "status" in response:
    print(f"gh: request failed (HTTP {response['status']})", file=sys.stderr)
    sys.exit(1)
if "raw" in response:
    sys.stdout.buffer.write(bytes.fromhex(response["raw"]))
elif "--jq" in arguments:
    key_name = arguments[arguments.index("--jq") + 1].removeprefix(".").removesuffix("[]")
    items = response["json"][key_name] if key_name else response["json"]
    print("\n".join(json.dumps(item) for item in items))
else:
    print(json.dumps(response["json"]))
